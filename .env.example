# ============================================================
# Simandou Screening — .env example
# Copy to .env and fill in values. NEVER commit .env.
# ============================================================

# --- Environment -------------------------------------------------------------
ENVIRONMENT=development           # development | staging | production
LOG_LEVEL=INFO                    # DEBUG | INFO | WARNING | ERROR
LOG_JSON=true

# --- Database (Postgres) -----------------------------------------------------
DATABASE_URL=postgresql+psycopg://screening_app:CHANGE_ME@127.0.0.1:5432/postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME       # used by docker-compose
POSTGRES_DB=postgres
POSTGRES_PORT=5433
AUTH_BYPASS_ROLE=auth_bypass_rls

# Pool tuning (S2)
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=30
DB_POOL_RECYCLE_SECONDS=1800
DB_POOL_TIMEOUT_SECONDS=10
# Set to true ONLY behind pgbouncer in transaction pooling mode
DB_DISABLE_PREPARED_STATEMENTS=false

# --- Auth --------------------------------------------------------------------
# Generate: python -c 'import secrets; print(secrets.token_urlsafe(48))'
SECRET_KEY=
# Generate: python -c 'import secrets; print(secrets.token_urlsafe(32))'
ADMIN_TOKEN=

# Token lifetimes (S3)
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30
REFRESH_TOKEN_ROTATION=true

# --- Storage -----------------------------------------------------------------
STORAGE_BACKEND=LOCAL             # LOCAL | S3  (S3 strongly recommended for prod)
LOCAL_STORAGE_ROOT=storage
PRESIGNED_URL_TTL_SECONDS=300

S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=
S3_REGION=us-east-1
S3_SECURE=false

# --- Anthropic (Claude Vision OCR) ------------------------------------------
ANTHROPIC_API_KEY=

# --- SumSub ------------------------------------------------------------------
SUMSUB_BASE_URL=https://api.sumsub.com
SUMSUB_APP_TOKEN=
SUMSUB_SECRET_KEY=
SUMSUB_LEVEL_NAME=basic-kyc
SUMSUB_WEBHOOK_SECRET=

# --- Observability -----------------------------------------------------------
SENTRY_DSN=                       # leave empty to disable Sentry
SENTRY_TRACES_SAMPLE_RATE=0.0

# --- Rate limit --------------------------------------------------------------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_LOGIN=10/minute
RATE_LIMIT_LOGIN_PER_IP_DAY=200/day

# --- Redis / Cache (S2) ------------------------------------------------------
# Leave empty to disable cache + run Celery in eager (sync inline) mode.
# Recommended for prod: redis://:<password>@host:6379/0
REDIS_URL=

MATCHING_CACHE_ENABLED=true
MATCHING_CACHE_TTL_SECONDS=300

# --- Celery (job queue, S2) --------------------------------------------------
# Falls back to REDIS_URL if empty. Worker: celery -A app.core.celery_app:celery_app worker -l info -c 4
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=
CELERY_TASK_TIME_LIMIT_SECONDS=300
CELERY_TASK_SOFT_LIMIT_SECONDS=240

# --- CORS --------------------------------------------------------------------
# Comma-separated list. Defaults are coded in app/core/config.py.
# CORS_ORIGINS=https://app.simandou-screening.com,http://localhost:5173
